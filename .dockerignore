# Build context for the Dockerfile: Go sources, web/ sources and the
# healthcheck probe. Everything else stays out so that caches stay warm and
# no local state (secrets, data, builds) reaches the image.
.git
.github
bin
data
dist
coverage.out
*.test
deploy
!deploy/healthcheck
docs
test
web/node_modules
web/dist
web/playwright-report
web/test-results
internal/webui/dist/*
!internal/webui/dist/.gitkeep
hangar.yaml
hangar.local.yaml
.env
.env.*
**/.DS_Store
