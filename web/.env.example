# The UI talks to a running Hangar server by default (proxied to HANGAR_BACKEND_URL).
# Set to true only for offline UI work: the API is then served from in-browser mock data.
VITE_API_MOCKS=false
# Where `npm run dev` and `npm run preview` proxy /api, /v2 and /repository.
HANGAR_BACKEND_URL=http://localhost:8080
