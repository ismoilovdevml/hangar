{
  "$defs": {
    "AptFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of apt repositories. Both keys apply to hosted and group repositories; a proxy serves the remote's metadata.",
      "properties": {
        "architectures": {
          "description": "Architectures listed in every distribution besides those of the uploaded packages (not `all`). Default `[amd64, arm64]`.",
          "items": {
            "anyOf": [
              {
                "examples": [
                  "amd64",
                  "arm64",
                  "i386"
                ],
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        },
        "signing_key": {
          "anyOf": [
            {
              "description": "Key that signs the metadata. Default `repository` (the repository's own key).",
              "enum": [
                "repository",
                "shared"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object",
      "x-format": "apt"
    },
    "BlobStoreInput": {
      "properties": {
        "fs": {
          "properties": {
            "path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            }
          },
          "type": "object"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "fs",
                "s3"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "s3": {
          "properties": {
            "access_key_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "bucket": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "endpoint": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "prefix": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "region": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "secret_access_key": {
              "anyOf": [
                {
                  "type": "string",
                  "writeOnly": true
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "use_path_style": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "soft_quota_bytes": {
          "description": "Soft quota; null or absent = none",
          "format": "int64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CargoFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of cargo repositories.",
      "properties": {
        "download_url": {
          "anyOf": [
            {
              "description": "Proxy only: the remote's crate download template, as `dl` in its\n`config.json` (markers `{crate}`, `{version}`, `{prefix}`,\n`{lowerprefix}`, `{sha256-checksum}`; without markers\n`/{crate}/{version}/download` is appended). Default: the remote's own `dl`.\n",
              "examples": [
                "https://static.crates.io/crates"
              ],
              "format": "uri",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object",
      "x-format": "cargo"
    },
    "CleanupCriteria": {
      "description": "Scope: `version_include` (if set) must match and, with\n`prerelease_only`, only pre-release / snapshot versions count. Versions\nmatching `version_exclude` or a `keep_matching` glob, quarantined\nversions and versions under legal hold (component attribute\n`legal_hold: true`) are never deleted and do not use `keep_newest`\nslots. Of the rest, the `keep_newest` most recently published versions\nper package are kept; the others are deleted when every set condition\nholds (AND). At least one of `older_than_days`, `not_downloaded_days`,\n`prerelease_only` or `keep_newest >= 1` is required.\n",
      "properties": {
        "keep_matching": {
          "description": "Version/tag globs never deleted (e.g. `release-*`, `latest`)",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "maxItems": 100,
          "type": "array"
        },
        "keep_newest": {
          "description": "Versions kept per package",
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "min_size_bytes": {
          "description": "Only versions at least this large (sum of their assets)",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "not_downloaded_days": {
          "description": "Not downloaded for N days (never-downloaded versions count from publication)",
          "maximum": 36500,
          "minimum": 1,
          "type": "integer"
        },
        "older_than_days": {
          "description": "Published more than N days ago",
          "maximum": 36500,
          "minimum": 1,
          "type": "integer"
        },
        "prerelease_only": {
          "description": "Only pre-release / snapshot versions: Maven `-SNAPSHOT` and unstable\nqualifiers, PEP 440 pre/dev releases for PyPI, SemVer pre-release\nidentifiers otherwise\n",
          "type": "boolean"
        },
        "version_exclude": {
          "anyOf": [
            {
              "description": "RE2 regular expression; matching versions are never deleted",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "version_include": {
          "anyOf": [
            {
              "description": "RE2 regular expression; only matching versions are in scope",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object"
    },
    "CleanupPolicyInput": {
      "properties": {
        "criteria": {
          "$ref": "#/$defs/CleanupCriteria"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "enabled": {
          "description": "Optional; true when omitted. A disabled policy does not run on its schedule.",
          "type": "boolean"
        },
        "format": {
          "oneOf": [
            {
              "$ref": "#/$defs/Format"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/RepositoryName"
        },
        "repositories": {
          "description": "Hosted or proxy repositories attached by the policy. The policy\nalso applies to repositories whose `config.cleanup_policies` names it.\n",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        },
        "schedule": {
          "anyOf": [
            {
              "description": "5-field cron in UTC (or @daily, @hourly, ...); null = manual only",
              "type": [
                "string",
                "null"
              ]
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object"
    },
    "ConnectorConfig": {
      "description": "Dedicated entry point, mainly for Docker clients that need a host root",
      "properties": {
        "host": {
          "anyOf": [
            {
              "description": "Virtual host name (e.g. cr.example.com) routed to Hangar",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "http_port": {
          "description": "Extra plain-HTTP listener serving only this repository; 0 = none",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DockerFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of docker repositories: none. Host and port connectors are `config.connector`.",
      "properties": {},
      "type": "object",
      "x-format": "docker"
    },
    "Duration": {
      "anyOf": [
        {
          "description": "Go duration string",
          "examples": [
            "24h0m0s",
            "90s"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/ValueFrom"
        }
      ]
    },
    "Format": {
      "anyOf": [
        {
          "enum": [
            "docker",
            "npm",
            "maven",
            "pypi",
            "go",
            "helm",
            "nuget",
            "cargo",
            "apt",
            "rpm",
            "raw"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/ValueFrom"
        }
      ]
    },
    "GoFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of go repositories.",
      "properties": {
        "sumdb_via": {
          "anyOf": [
            {
              "description": "Proxy only. Where checksum database requests go. `database` (default) asks `https://<name>/` itself; `remote` asks `<remote_url>/sumdb/<name>/`, for remotes that proxy the database (an inner Hangar, Athens).",
              "enum": [
                "database",
                "remote"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "sumdbs": {
          "description": "Proxy only. Checksum databases served under `sumdb/<name>/`. Absent means `[sum.golang.org]`; an empty list turns the pass-through off.",
          "items": {
            "anyOf": [
              {
                "examples": [
                  "sum.golang.org"
                ],
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        }
      },
      "type": "object",
      "x-format": "go"
    },
    "GroupMapping": {
      "properties": {
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "required": [
        "provider",
        "group"
      ],
      "type": "object"
    },
    "HelmFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of helm repositories: none; any key is rejected.",
      "maxProperties": 0,
      "properties": {},
      "type": "object",
      "x-format": "helm"
    },
    "Labels": {
      "additionalProperties": {
        "anyOf": [
          {
            "maxLength": 256,
            "type": "string"
          },
          {
            "$ref": "#/$defs/ValueFrom"
          }
        ]
      },
      "description": "Up to 64 labels. Keys are `[prefix/]name`: an optional DNS-style prefix, then 1-63 letters, digits, `-`, `_` or `.` starting and ending with a letter or digit. Values are at most 256 characters without control characters. The `hangar/` prefix is used by `hangar apply`.",
      "example": {
        "hangar/apply-set": "platform",
        "hangar/managed-by": "hangar-apply",
        "team": "web"
      },
      "maxProperties": 64,
      "type": "object"
    },
    "MavenFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of maven repositories. Other keys are rejected.",
      "properties": {
        "layout_policy": {
          "anyOf": [
            {
              "description": "`strict` stores only Maven-layout paths; `permissive` also stores other files. Default `strict`.",
              "enum": [
                "strict",
                "permissive"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "version_policy": {
          "anyOf": [
            {
              "description": "Versions the repository accepts. Default `mixed`.",
              "enum": [
                "release",
                "snapshot",
                "mixed"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object",
      "x-format": "maven"
    },
    "MemberRouting": {
      "properties": {
        "block": {
          "description": "Names this member never serves through the group.",
          "items": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "maxItems": 256,
          "type": "array"
        },
        "exclusive": {
          "description": "Names reserved for this member: a name matching the exclusive patterns of one or more members is served only by them.",
          "example": [
            "Edcom.*"
          ],
          "items": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "maxItems": 256,
          "type": "array"
        },
        "member": {
          "$ref": "#/$defs/RepositoryName"
        }
      },
      "required": [
        "member"
      ],
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "allOf": [
            {
              "$ref": "#/$defs/Labels"
            }
          ],
          "description": "Labels of the resource. Keys under hangar/ are reserved for hangar apply."
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NpmFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of npm repositories.",
      "properties": {
        "login_token_ttl": {
          "allOf": [
            {
              "$ref": "#/$defs/Duration"
            }
          ],
          "description": "Lifetime of tokens issued by `npm login`. Default `720h` (30 days)."
        },
        "reuse_unpublished_versions": {
          "description": "Let a version number be published again after it was unpublished. Default false (a version always names the same bytes).",
          "type": "boolean"
        },
        "unpublish_window": {
          "allOf": [
            {
              "$ref": "#/$defs/Duration"
            }
          ],
          "description": "How long after publishing a holder of `repo:<name>:delete` may unpublish a version (`repo:<name>:admin` always may). Default `72h`; `0s` means administrators only."
        }
      },
      "type": "object",
      "x-format": "npm"
    },
    "NugetFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of nuget repositories.",
      "properties": {
        "delete_mode": {
          "anyOf": [
            {
              "description": "What `DELETE api/v2/package/{id}/{version}` (`dotnet nuget delete`) does. Default `unlist`.",
              "enum": [
                "unlist",
                "delete"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "service_index": {
          "anyOf": [
            {
              "description": "Proxy only. The remote's service index path, relative to `remote_url`. Default `v3/index.json`.\nSensitive, as some feeds carry their key in this path: returned only to administrators of\nthe repository (`repo:<name>:admin`, `system:repos:admin`), as `***` to everyone else. An\nupdate that sends `***` keeps the stored value.\n",
              "examples": [
                "v3/index.json",
                "index.json"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object",
      "x-format": "nuget"
    },
    "OutboundProxyInput": {
      "allOf": [
        {
          "$ref": "#/$defs/OutboundProxySettings"
        },
        {
          "properties": {
            "clear_password": {
              "type": "boolean"
            },
            "name": {
              "anyOf": [
                {
                  "description": "Required on create; cannot change",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            },
            "password": {
              "anyOf": [
                {
                  "description": "New password; empty keeps the stored one",
                  "type": "string",
                  "writeOnly": true
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            }
          },
          "type": "object"
        }
      ]
    },
    "OutboundProxySettings": {
      "properties": {
        "ca_pem": {
          "anyOf": [
            {
              "description": "PEM certificates trusted for requests through this proxy",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "default": {
          "description": "The platform default; at most one proxy",
          "type": "boolean"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "no_proxy": {
          "description": "Hosts, domain suffixes (.corp.example), IPs and CIDRs reached directly",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "redirect_hosts": {
          "description": "Hosts upstream redirects may lead to and still use this proxy (a\nregistry's CDN). When not empty, only the repository's remote host and\nthese hosts go through the proxy. Empty: every host does.\n",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        },
        "scheme": {
          "anyOf": [
            {
              "description": "How Hangar talks to the proxy",
              "enum": [
                "http",
                "https"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueFrom"
            }
          ]
        }
      },
      "type": "object"
    },
    "Privilege": {
      "anyOf": [
        {
          "examples": [
            "repo:*:read",
            "repo:npm-*:write",
            "system:users:admin",
            "system:*"
          ],
          "pattern": "^(repo|system):[^:]+:(read|write|delete|admin|\\*)$|^system:\\*$",
          "type": "string"
        },
        {
          "$ref": "#/$defs/ValueFrom"
        }
      ]
    },
    "PypiFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of pypi repositories.",
      "properties": {
        "file_hosts": {
          "description": "Proxy only. Hosts (`host`, `host:port`, or `.domain` for its subdomains) distribution files may be downloaded from when the remote links elsewhere. Default `[files.pythonhosted.org]`; the remote's own host is always allowed.",
          "items": {
            "anyOf": [
              {
                "examples": [
                  "files.pythonhosted.org",
                  ".example.com"
                ],
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        }
      },
      "type": "object",
      "x-format": "pypi"
    },
    "RawFormatConfig": {
      "additionalProperties": true,
      "description": "`config.format` of raw repositories: none; any key is rejected.",
      "maxProperties": 0,
      "properties": {},
      "type": "object",
      "x-format": "raw"
    },
    "RepositoryConfig": {
      "description": "Exactly one of hosted, proxy, group is set, matching the repository type.",
      "properties": {
        "anonymous_read": {
          "type": "boolean"
        },
        "cleanup_policies": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/ValueFrom"
              }
            ]
          },
          "type": "array"
        },
        "connector": {
          "$ref": "#/$defs/ConnectorConfig"
        },
        "format": {
          "additionalProperties": true,
          "anyOf": [
            {
              "$ref": "#/$defs/AptFormatConfig"
            },
            {
              "$ref": "#/$defs/CargoFormatConfig"
            },
            {
              "$ref": "#/$defs/DockerFormatConfig"
            },
            {
              "$ref": "#/$defs/GoFormatConfig"
            },
            {
              "$ref": "#/$defs/HelmFormatConfig"
            },
            {
              "$ref": "#/$defs/MavenFormatConfig"
            },
            {
              "$ref": "#/$defs/NpmFormatConfig"
            },
            {
              "$ref": "#/$defs/NugetFormatConfig"
            },
            {
              "$ref": "#/$defs/PypiFormatConfig"
            },
            {
              "$ref": "#/$defs/RawFormatConfig"
            },
            {
              "$ref": "#/$defs/RpmFormatConfig"
            }
          ],
          "description": "Format-specific settings. The keys depend on the repository's\n`format`; each format's keys are described by its own schema:\napt `AptFormatConfig`, cargo `CargoFormatConfig`, docker\n`DockerFormatConfig`, go `GoFormatConfig`, helm `HelmFormatConfig`,\nmaven `MavenFormatConfig`, npm `NpmFormatConfig`, nuget\n`NugetFormatConfig`, pypi `PypiFormatConfig`, raw `RawFormatConfig`,\nrpm `RpmFormatConfig` (also listed in `x-format-schemas`). Absent keys\ntake the defaults shown there.\n",
          "type": "object",
          "x-format-schemas": {
            "apt": "#/$defs/AptFormatConfig",
            "cargo": "#/$defs/CargoFormatConfig",
            "docker": "#/$defs/DockerFormatConfig",
            "go": "#/$defs/GoFormatConfig",
            "helm": "#/$defs/HelmFormatConfig",
            "maven": "#/$defs/MavenFormatConfig",
            "npm": "#/$defs/NpmFormatConfig",
            "nuget": "#/$defs/NugetFormatConfig",
            "pypi": "#/$defs/PypiFormatConfig",
            "raw": "#/$defs/RawFormatConfig",
            "rpm": "#/$defs/RpmFormatConfig"
          }
        },
        "group": {
          "properties": {
            "members": {
              "description": "Member repository names in resolution order",
              "items": {
                "$ref": "#/$defs/RepositoryName"
              },
              "type": "array"
            },
            "write_member": {
              "anyOf": [
                {
                  "description": "Hosted member receiving writes sent to the group (docker, npm)",
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/ValueFrom"
                }
              ]
            }
          },
          "required": [
            "members"
          ],
          "type": "object"
        },
        "hosted": {
          "properties": {
            "write_policy": {
              "$ref": "#/$defs/WritePolicy"
            }
          },
          "type": "object"
        },
        "proxy": {
          "properties": {
            "auth": {
