# Caddy in front of Hangar: automatic TLS (Let's Encrypt / ZeroSSL) for the
# UI host and a separate Docker registry host. install.sh writes this file to
# <data>/caddy/Caddyfile on every run (put your own sites in caddy/sites/);
# the host names come from the installer settings.
#
# Caddy does not limit request bodies and streams them to Hangar without
# buffering by default, which multi-GB image layers and artifacts need.
{
	# ACME account e-mail for expiry notices (--acme-email); install.sh
	# removes this line when none is given.
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 30s
			idle 5m
		}
		# HTTP/3 needs 443/udp, published in compose.yaml.
		protocols h1 h2 h3
	}
}

(hangar_upstream) {
	reverse_proxy hangar:8080 {
		# Stream downloads and the live event feed (SSE) immediately.
		flush_interval -1
		transport http {
			dial_timeout 10s
		}
	}
}

# Hangar sets HSTS (security.hsts), nosniff and CSP itself; it sees HTTPS
# through X-Forwarded-Proto from this proxy (server.trusted_proxies).
(security_headers) {
	header -Server
}

# UI, REST API and every package format (/repository/<repo>/..., /v2/...).
{$HANGAR_DOMAIN} {
	import security_headers
	# Prometheus metrics are unauthenticated: scrape them on the internal
	# network (hangar:8080/metrics), never through the public host.
	@metrics path /metrics
	respond @metrics 404
	import hangar_upstream
	log
}

# More sites: every sites/*.caddy file (mounted at /etc/caddy/sites) is
# loaded here and may use the snippets above. sites/registry.caddy adds the
# separate Docker registry host; remove it if you do not want one. Docker
# host connectors (connector.host) are added the same way.
import /etc/caddy/sites/*.caddy
