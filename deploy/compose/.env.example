# Hangar compose stack settings. Copy to .env, fill in, and protect it:
#
#   cp .env.example .env && chmod 600 .env
#
# Generate secrets with URL-safe characters only (they end up inside URLs):
#   openssl rand -hex 24          # passwords and keys
#   openssl rand -base64 48       # HANGAR_DOCKER_TOKEN_KEY

# ---- Services --------------------------------------------------------------
# Bundled services to run. Drop one to use an external service instead:
#   postgres  -> set HANGAR_DATABASE_URL below
#   minio     -> set HANGAR_STORAGE_S3_* to your S3 endpoint (or HANGAR_STORAGE_KIND=fs)
#   caddy     -> publish Hangar through your own proxy (HANGAR_BIND_ADDR/HANGAR_HTTP_PORT)
COMPOSE_PROFILES=postgres,minio,caddy

HANGAR_IMAGE=ghcr.io/ismoilovdevml/hangar:latest

# ---- Public addresses ------------------------------------------------------
# Host names (DNS A/AAAA records must point at this host for automatic TLS).
HANGAR_DOMAIN=hangar.example.com
# Separate host for Docker clients: docker push registry.example.com/<repo>/<image>:<tag>
# Served by sites/registry.caddy; delete that file if you do not want one.
HANGAR_REGISTRY_DOMAIN=registry.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# External URL of the UI host; every generated link uses it. No trailing slash.
HANGAR_BASE_URL=https://hangar.example.com

# Where the hangar container is published on the host. Keep loopback when
# Caddy runs; use 0.0.0.0 only behind another proxy on a trusted network.
HANGAR_BIND_ADDR=127.0.0.1
HANGAR_HTTP_PORT=8080
# Docker network of the stack; Hangar trusts X-Forwarded-* only from it.
HANGAR_NETWORK_SUBNET=172.30.80.0/24
HANGAR_TRUSTED_PROXIES=172.30.80.0/24

# ---- First administrator ---------------------------------------------------
# Created on first start when no administrator exists; ignored afterwards.
# Remove both lines after the first login and change the password in the UI.
HANGAR_BOOTSTRAP_ADMIN_USER=admin
HANGAR_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Secrets -----------------------------------------------------------------
# Signs Docker registry tokens and upload URLs. Keep it stable: changing it
# invalidates registry logins (15 min) and unfinished uploads.
HANGAR_DOCKER_TOKEN_KEY=
# Encrypts the credentials Hangar stores in PostgreSQL (proxy upstream
# passwords, S3 keys): 32 random bytes, `openssl rand -base64 32`. Back it up
# with the database: without it those credentials cannot be decrypted.
HANGAR_SECRET_KEY=
# After a rotation: the old key(s), comma-separated, until
# `hangar admin rotate-secrets` has run (docs/security.md).
# HANGAR_SECURITY_PREVIOUS_SECRET_KEYS=

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=hangar
POSTGRES_PASSWORD=
POSTGRES_DB=hangar
# External PostgreSQL instead of the postgres profile (remove "postgres" from
# COMPOSE_PROFILES). Percent-encode special characters in the password.
# HANGAR_DATABASE_URL=postgres://hangar:PASSWORD@db.internal:5432/hangar?sslmode=verify-full

# Tuning for the bundled PostgreSQL (defaults suit an 8 GB host).
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
# POSTGRES_WORK_MEM=16MB
# POSTGRES_MAINTENANCE_WORK_MEM=256MB
# POSTGRES_MAX_CONNECTIONS=200
# POSTGRES_MEMORY=3g

# ---- Blob storage ------------------------------------------------------------
# s3 (bundled MinIO or any S3 endpoint) or fs (the hangar-data volume).
HANGAR_STORAGE_KIND=s3
HANGAR_STORAGE_S3_ENDPOINT=http://minio:9000
HANGAR_STORAGE_S3_REGION=us-east-1
HANGAR_STORAGE_S3_BUCKET=hangar
HANGAR_STORAGE_S3_USE_PATH_STYLE=true
# Credentials Hangar uses. With the minio profile, minio-init creates this
# user with access to the bucket only.
HANGAR_STORAGE_S3_ACCESS_KEY_ID=hangar
HANGAR_STORAGE_S3_SECRET_ACCESS_KEY=
# AWS S3 example: endpoint empty, virtual-hosted style.
# HANGAR_STORAGE_S3_ENDPOINT=
# HANGAR_STORAGE_S3_REGION=eu-central-1
# HANGAR_STORAGE_S3_USE_PATH_STYLE=false

# MinIO root credentials (minio profile only; never given to Hangar).
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=

# ---- Corporate outbound proxy ------------------------------------------------
# Used by proxy repositories to reach Maven Central, npmjs, Docker Hub, ...
# HANGAR_HTTP_PROXY=http://proxy.corp.example:3128
# HANGAR_HTTP_PROXY_USERNAME=
# HANGAR_HTTP_PROXY_PASSWORD=
# Comma-separated hosts, .domain suffixes and CIDRs reached directly.
# HANGAR_HTTP_NO_PROXY=.corp.example,10.0.0.0/8

# ---- Resource limits ---------------------------------------------------------
# HANGAR_CPUS=4
# HANGAR_MEMORY=4g
# MINIO_CPUS=2
# MINIO_MEMORY=2g
